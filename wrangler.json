{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vite-ness",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"CORS_ORIGIN": "*"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "TODO_STORE",
				"class_name": "TodoStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TodoStore"]
		}
	]
}
